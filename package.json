{
  "name": "dsh-prompt-loader",
  "version": "0.2.1",
  "type": "module",
  "description": "Inject a system-prompt section into a DeepSeek Harness agent from per-language TXT files or inline text maps, with hot-reload on edits or language switches.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/butterfly301/dsh-prompt-loader.git"
  },
  "homepage": "https://github.com/butterfly301/dsh-prompt-loader#readme",
  "bugs": {
    "url": "https://github.com/butterfly301/dsh-prompt-loader/issues"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "system-prompt",
    "i18n",
    "cordis"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
